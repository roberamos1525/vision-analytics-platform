# Copy to .env and fill in. Never commit real keys.

# API keys: comma-separated "key:role" (roles: viewer, operator, admin; keys >= 16 chars).
VAP_API_KEYS=change-me-admin-key-000000:admin,change-me-viewer-key-00000:viewer

# Optional HMAC secret for webhook signatures (X-VAP-Signature).
VAP_WEBHOOK_SECRET=

# Optional config file (TOML); env vars override it.
# VAP_CONFIG=examples/configs/vap.toml

# Any setting can be overridden with VAP_<SECTION>__<FIELD>:
VAP_SERVER__HOST=127.0.0.1
VAP_SERVER__PORT=8080
VAP_STORAGE__STATE_DIR=var
VAP_PIPELINES__IMAGE_BACKEND=auto
VAP_PIPELINES__MAX_PIPELINES=8
VAP_LOGGING__LEVEL=info
VAP_LOGGING__FORMAT=json
# VAP_MEDIA__ROOTS=["/srv/videos"]
# VAP_WEBHOOKS__URLS=https://hooks.example.com/vap
# VAP_AUTH__ENABLED=false   # local experiments only
